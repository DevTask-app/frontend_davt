# PostgreSQL connection string. The API (Prisma) reads this at runtime.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/davt_next

# Secret for signing JWT access tokens (HS256). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string-32+

# Base URL of the frontend; used in invitation accept URLs.
FRONTEND_URL=http://localhost:3000

# Mailer. Phase 1 logs emails to the console; point SMTP at Mailpit for local testing.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=DevT

# Public app name shown in the UI.
NEXT_PUBLIC_APP_NAME=DevT
