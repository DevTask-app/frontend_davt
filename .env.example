# PostgreSQL connection string. The API (Prisma) reads this at runtime.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/davt_next

# Secret for signing JWT access tokens (HS256). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string-32+

# Base URL of the frontend; used in invitation accept URLs.
FRONTEND_URL=http://localhost:3000

# Mailer. "log" prints emails to the console (Laravel MAIL_MAILER=log);
# "smtp" delivers them. For local testing point SMTP at Mailpit (127.0.0.1:1025).
# Leave MAIL_SCHEME/USERNAME/PASSWORD empty when the server needs no auth.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=DevT

# Public app name shown in the UI.
NEXT_PUBLIC_APP_NAME=DevT
