generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String    @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  password      String    @db.VarChar(255)
  role          String    @default("User") @db.VarChar(20)
  rememberToken String?   @map("remember_token") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  invitedMembers  WorkspaceMember[]     @relation("MemberInvitedBy")
  invitations     WorkspaceInvitation[] @relation("InvitationInvitedBy")
  ownedProjects   Project[]             @relation("ProjectOwner")
  createdProjects Project[]             @relation("ProjectCreatedBy")
  createdTasks    Task[]                @relation("TaskCreatedBy")
  updatedTasks    Task[]                @relation("TaskUpdatedBy")
  assignedTasks   Task[]                @relation("TaskAssignee")
  activityLogs    TaskActivityLog[]
  attachments     TaskAttachment[]

  @@map("users")
}

model Workspace {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(150)
  slug       String   @unique(map: "workspaces_slug_unique") @db.VarChar(180)
  isPersonal Boolean  @default(false) @map("is_personal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  userId      Int       @map("user_id")
  role        String    @default("Member") @db.VarChar(20)
  invitedBy   Int?      @map("invited_by")
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workspace_members_workspace_id_foreign")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workspace_members_user_id_foreign")
  inviter   User?     @relation("MemberInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "workspace_members_invited_by_foreign")

  @@unique([workspaceId, userId], map: "workspace_members_workspace_id_user_id_unique")
  @@index([userId], map: "workspace_members_user_id_index")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  email       String    @db.VarChar(255)
  role        String    @default("Member") @db.VarChar(20)
  token       String    @unique(map: "workspace_invitations_token_unique") @db.VarChar(64)
  invitedBy   Int?      @map("invited_by")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workspace_invitations_workspace_id_foreign")
  inviter   User?     @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "workspace_invitations_invited_by_foreign")

  @@index([workspaceId, email], map: "workspace_invitations_workspace_id_email_index")
  @@map("workspace_invitations")
}

model Project {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  userId      Int       @map("user_id")
  createdBy   Int       @map("created_by")
  name        String    @db.VarChar(150)
  description String?   @db.Text
  status      String    @default("Active") @db.VarChar(20)
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_workspace_id_foreign")
  owner     User      @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "projects_user_id_foreign")
  creator   User      @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "projects_created_by_foreign")
  tasks     Task[]

  @@index([userId], map: "projects_user_id_index")
  @@index([status], map: "projects_status_index")
  @@index([dueDate], map: "projects_due_date_index")
  @@index([workspaceId])
  @@map("projects")
}

model Task {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  createdBy      Int       @map("created_by")
  updatedBy      Int?      @map("updated_by")
  parentTaskId   Int?      @map("parent_task_id")
  assigneeId     Int?      @map("assignee_id")
  title          String    @db.VarChar(200)
  description    String?   @db.Text
  type           String    @db.VarChar(30)
  status         String    @default("Backlog") @db.VarChar(30)
  priority       String    @default("Medium") @db.VarChar(20)
  dueDate        DateTime? @map("due_date") @db.Date
  estimatedHours Decimal?  @map("estimated_hours") @db.Decimal(8, 2)
  actualHours    Decimal?  @map("actual_hours") @db.Decimal(8, 2)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  blockedReason  String?   @map("blocked_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "tasks_project_id_foreign")
  creator     User          @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "tasks_created_by_foreign")
  updater     User?         @relation("TaskUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "tasks_updated_by_foreign")
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "tasks_assignee_id_foreign")
  parent      Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_parent_task_id_foreign")
  subtasks    Task[]        @relation("TaskHierarchy")
  logs        TaskActivityLog[]
  attachments TaskAttachment[]

  @@index([projectId], map: "tasks_project_id_index")
  @@index([status], map: "tasks_status_index")
  @@index([priority], map: "tasks_priority_index")
  @@index([createdBy], map: "tasks_created_by_index")
  @@index([updatedBy], map: "tasks_updated_by_index")
  @@index([parentTaskId], map: "tasks_parent_task_id_index")
  @@index([dueDate], map: "tasks_due_date_index")
  @@index([type])
  @@index([assigneeId])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_activity_logs_task_id_foreign")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "task_activity_logs_user_id_foreign")

  @@index([taskId], map: "task_activity_logs_task_id_index")
  @@index([userId], map: "task_activity_logs_user_id_index")
  @@map("task_activity_logs")
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int      @map("task_id")
  userId       Int      @map("user_id")
  disk         String   @default("local") @db.VarChar(50)
  path         String   @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_attachments_task_id_foreign")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "task_attachments_user_id_foreign")

  @@index([taskId], map: "task_attachments_task_id_index")
  @@index([userId], map: "task_attachments_user_id_index")
  @@map("task_attachments")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(255)
  notifiableType String    @map("notifiable_type") @db.VarChar(255)
  notifiableId   Int       @map("notifiable_id")
  data           Json
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([notifiableType, notifiableId], map: "notifications_notifiable_type_notifiable_id_index")
  @@map("notifications")
}
